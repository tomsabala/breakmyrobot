#
# Remove an obstacle previously spawned by SpawnObstacle.
#
# Served as /faults/clear_obstacle by ral_faults/fault_manager.py (Phase 4.1).
# Injection point: /world/<world>/remove (gz UserCommands).
#
# `name` must be the name the obstacle was spawned under. Removing a name that
# was never spawned is a failure, not a no-op: a silent success would let a
# run report a cleared fault that never existed.

string name
---
bool success
string message
