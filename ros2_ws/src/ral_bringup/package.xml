<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ral_bringup</name>
  <version>0.1.0</version>
  <description>
    Launch files and the ROS-to-Gazebo bridge configuration that bring one
    Resilient Autonomy Lab robot up in one world. The bridge config is also the
    single place where the project's localization-honesty rule is enforced:
    wheel odometry reaches /tf, simulator truth never does.
  </description>
  <maintainer email="noreply@example.com">Resilient Autonomy Lab</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>ral_description</exec_depend>
  <exec_depend>ral_eval</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>sdformat_urdf</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
