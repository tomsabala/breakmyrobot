<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ral_eval</name>
  <version>0.1.0</version>
  <description>
    Evaluation-side nodes and helpers: they observe the robot, they never drive
    it. ground_truth_node republishes simulator ground truth on an
    evaluation-only topic and deliberately broadcasts no TF, so no localization
    or navigation component can consume truth by accident.
    capture_world_to_map measures the gz world -> SLAM map alignment once per
    map, and frames.py is the single implementation of that conversion, shared
    by the nav launch file and the Phase 3 metrics.
  </description>
  <maintainer email="noreply@example.com">Resilient Autonomy Lab</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <!-- Phase 3: the scenario runner, the bag reader and the metrics/plot
       artifacts. ral_interfaces carries the mission and fault vocabulary;
       ros2bag and rosbag2_storage_mcap are the recorder and its storage
       plugin, which run_scenario starts as a subprocess; rosbag2_py reads
       the result back. rosidl_runtime_py resolves a bag's message types
       (bagio.py) and the installed rosbag2_py declares it only as a
       test_depend, so it is present today by accident of ros2cli;
       ament_index_python resolves the package share directories
       (run_scenario.py) and is otherwise only transitive through rclpy.
       Every entry here is imported somewhere under ral_eval/. -->
  <exec_depend>ral_interfaces</exec_depend>
  <exec_depend>nav2_msgs</exec_depend>
  <exec_depend>action_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>rosidl_runtime_py</exec_depend>
  <exec_depend>rosbag2_py</exec_depend>
  <exec_depend>ros2bag</exec_depend>
  <exec_depend>rosbag2_storage_mcap</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-numpy</exec_depend>

  <!-- Phase 5, the car. mavros_msgs carries State, EstimatorStatus,
       NavControllerOutput and the SetMode/CommandBool services the MAVROS
       mission driver uses (mavros_driver.py); tf2_ros is the broadcaster
       ekf_local_tf.py publishes map -> ekf_local -> base_link with;
       rosgraph_msgs is /clock's Clock type, which the generic bring-up gate
       subscribes to by the type name a robot profile declares. -->
  <exec_depend>mavros_msgs</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>

  <!-- Phase 6, the dashboard gateway (dashboard_api.py). std_srvs carries
       Trigger, the type of /faults/clear_all; ros_gz_interfaces carries
       Contacts, the type the /bumper bridge publishes, which the console's
       contact row decodes. Both are imported only by the gateway: a missing
       ros_gz_interfaces degrades that one row to a stated "unavailable"
       rather than failing the process. -->
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>ros_gz_interfaces</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
