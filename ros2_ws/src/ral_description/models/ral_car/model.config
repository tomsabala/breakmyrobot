<?xml version="1.0"?>
<model>
  <name>ral_car</name>
  <version>0.1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>Resilient Autonomy Lab</name>
  </author>

  <description>
    Ackermann-steered research rover (chosen geometry, not a specific product)
    carrying an RPLIDAR A1 and driven by ArduRover SITL through ArduPilotPlugin.
    model.config must sit next to model.sdf for `model://ral_car` to resolve
    through GZ_SIM_RESOURCE_PATH.
  </description>
</model>
