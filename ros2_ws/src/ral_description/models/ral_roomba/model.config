<?xml version="1.0"?>
<model>
  <name>ral_roomba</name>
  <version>0.1.0</version>
  <sdf version="1.9">model.sdf</sdf>

  <author>
    <name>Resilient Autonomy Lab</name>
  </author>

  <description>
    Differential-drive cleaning-robot chassis (iRobot Create 3 dimensions and
    limits) carrying an RPLIDAR A1 on its lid. model.config must sit next to
    model.sdf for `model://ral_roomba` to resolve through GZ_SIM_RESOURCE_PATH.
  </description>
</model>
