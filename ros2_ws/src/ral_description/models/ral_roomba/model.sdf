<?xml version="1.0" ?>
<!--
  ral_roomba - differential-drive floor robot.

  Provenance: this is an **iRobot Create 3 chassis carrying an RPLIDAR A1**, a
  real research configuration, not a retail Roomba. A retail Roomba has bump and
  cliff sensors and no 360-degree lidar; modelling one with a lidar and calling
  it a Roomba would be a fabricated platform. Dimensions and limits below come
  from the Create 3 specification (335 mm diameter, 235 mm wheel separation,
  72 mm wheel diameter, 0.46 m/s max linear, 1.9 rad/s max angular) and the
  RPLIDAR A1 datasheet (0.15-12 m range, 360 samples, ~10 Hz, ~1-2 % range
  error, modelled here as sigma = 0.015 m).

  No model-level <pose>: sdformat_urdf rejects `<model> tags with <pose>` and
  robot_state_publisher aborts on it (verified). The spawn pose lives in the
  world's <include> instead - see worlds/ral_apartment.sdf.

  The z offsets of the wheels and casters assume the spawn height z = 0.05 used
  in that <include>: wheel centres (-0.014 below base centre, base half-height
  0.045) and caster centres then sit exactly at their own radii above the floor.
  Changing the spawn height without changing these offsets puts the robot on its
  hull and the wheels lose traction.
-->
<sdf version="1.9">
  <model name="ral_roomba">

    <!-- Chassis. The collision is named base_collision because the contact
         sensor below references it by name, and the bumper check asserts on
         the generated contact name `ral_roomba::base_link::base_collision`. -->
    <link name="base_link">
      <inertial>
        <mass>3.5</mass>
        <inertia>
          <ixx>0.0269</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.0269</iyy><iyz>0</iyz>
          <izz>0.0491</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <geometry><cylinder><radius>0.1675</radius><length>0.09</length></cylinder></geometry>
      </collision>
      <visual name="base_visual">
        <geometry><cylinder><radius>0.1675</radius><length>0.09</length></cylinder></geometry>
        <material><ambient>0.2 0.2 0.22 1</ambient><diffuse>0.25 0.25 0.28 1</diffuse></material>
      </visual>

      <!-- gz-sim-imu-system must be loaded by the world or this sensor
           publishes nothing at all (verified: no /imu topic appears).
           <gz_frame_id> is likewise required - without it the messages are
           stamped `ral_roomba/base_link/imu_sensor` instead of `base_link`,
           which resolves in no TF tree. -->
      <sensor name="imu_sensor" type="imu">
        <topic>imu</topic>
        <gz_frame_id>base_link</gz_frame_id>
        <update_rate>100</update_rate>
        <always_on>1</always_on>
      </sensor>

      <!-- Bumper. A contact sensor IGNORES its <topic>: gz always publishes on
           /world/<world>/model/<model>/link/<link>/sensor/<sensor>/contact
           (verified). The bridge config uses that generated name; the <topic>
           here is inert and kept only so the SDF is self-describing.
           Requires gz-sim-contact-system in the world. -->
      <sensor name="bumper" type="contact">
        <topic>bumper</topic>
        <update_rate>50</update_rate>
        <always_on>1</always_on>
        <contact>
          <collision>base_collision</collision>
        </contact>
      </sensor>
    </link>

    <!-- RPLIDAR A1, visual only: the scanner body is inside the robot's own
         footprint, so a collision here would add nothing but contact noise. -->
    <link name="rplidar_link">
      <pose>0 0 0.08 0 0 0</pose>
      <inertial>
        <mass>0.17</mass>
        <inertia>
          <ixx>8.24e-5</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>8.24e-5</iyy><iyz>0</iyz>
          <izz>1.2e-4</izz>
        </inertia>
      </inertial>
      <visual name="rplidar_visual">
        <geometry><cylinder><radius>0.0375</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>

      <!-- Without <gz_frame_id> the scan is stamped with the scoped sensor name
           (`ral_roomba::rplidar_link::rplidar`), which matches no TF frame and
           silently breaks every costmap that transforms the scan (verified). -->
      <sensor name="rplidar" type="gpu_lidar">
        <topic>scan_raw</topic>
        <gz_frame_id>rplidar_link</gz_frame_id>
        <update_rate>10</update_rate>
        <always_on>1</always_on>
        <visualize>false</visualize>
        <lidar>
          <scan>
            <horizontal>
              <samples>360</samples>
              <resolution>1</resolution>
              <min_angle>-3.14159</min_angle>
              <max_angle>3.14159</max_angle>
            </horizontal>
          </scan>
          <range>
            <min>0.15</min>
            <max>12.0</max>
            <resolution>0.01</resolution>
          </range>
          <noise>
            <type>gaussian</type>
            <mean>0</mean>
            <stddev>0.015</stddev>
          </noise>
        </lidar>
      </sensor>
    </link>

    <link name="left_wheel">
      <pose>0 0.1175 -0.014 -1.5707 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>3.6e-5</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>3.6e-5</iyy><iyz>0</iyz>
          <izz>6.5e-5</izz>
        </inertia>
      </inertial>
      <collision name="left_wheel_collision">
        <geometry><cylinder><radius>0.036</radius><length>0.02</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="left_wheel_visual">
        <geometry><cylinder><radius>0.036</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
    </link>

    <link name="right_wheel">
      <pose>0 -0.1175 -0.014 -1.5707 0 0</pose>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>3.6e-5</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>3.6e-5</iyy><iyz>0</iyz>
          <izz>6.5e-5</izz>
        </inertia>
      </inertial>
      <collision name="right_wheel_collision">
        <geometry><cylinder><radius>0.036</radius><length>0.02</length></cylinder></geometry>
        <surface>
          <friction>
            <ode><mu>1.0</mu><mu2>1.0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="right_wheel_visual">
        <geometry><cylinder><radius>0.036</radius><length>0.02</length></cylinder></geometry>
        <material><ambient>0.05 0.05 0.05 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
    </link>

    <!-- Casters are frictionless spheres: a real Create 3 rides on a low-friction
         caster, and giving these friction would add a yaw resistance the robot
         does not have. -->
    <link name="caster_front">
      <pose>0.12 0 -0.035 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>4.5e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>4.5e-6</iyy><iyz>0</iyz>
          <izz>4.5e-6</izz>
        </inertia>
      </inertial>
      <collision name="caster_front_collision">
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
        <surface>
          <friction>
            <ode><mu>0.0</mu><mu2>0.0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="caster_front_visual">
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
      </visual>
    </link>

    <link name="caster_rear">
      <pose>-0.12 0 -0.035 0 0 0</pose>
      <inertial>
        <mass>0.05</mass>
        <inertia>
          <ixx>4.5e-6</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>4.5e-6</iyy><iyz>0</iyz>
          <izz>4.5e-6</izz>
        </inertia>
      </inertial>
      <collision name="caster_rear_collision">
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
        <surface>
          <friction>
            <ode><mu>0.0</mu><mu2>0.0</mu2></ode>
          </friction>
        </surface>
      </collision>
      <visual name="caster_rear_visual">
        <geometry><sphere><radius>0.015</radius></sphere></geometry>
        <material><ambient>0.3 0.3 0.3 1</ambient><diffuse>0.4 0.4 0.4 1</diffuse></material>
      </visual>
    </link>

    <joint name="rplidar_joint" type="fixed">
      <parent>base_link</parent>
      <child>rplidar_link</child>
    </joint>

    <joint name="caster_front_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster_front</child>
    </joint>

    <joint name="caster_rear_joint" type="fixed">
      <parent>base_link</parent>
      <child>caster_rear</child>
    </joint>

    <!-- expressed_in="__model__" keeps the axis in model coordinates despite the
         -90 deg roll on the wheel links, so both wheels spin about +y. -->
    <joint name="left_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <joint name="right_wheel_joint" type="revolute">
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz expressed_in="__model__">0 1 0</xyz>
        <limit>
          <lower>-1e16</lower>
          <upper>1e16</upper>
        </limit>
      </axis>
    </joint>

    <!-- Plant limits, with their provenance, because Phase 2's Nav2 controller
         and velocity smoother inherit them as hard ceilings:
           max_linear_velocity 0.46 m/s, max_angular_velocity 1.9 rad/s -
             iRobot Create 3 specification. These are the ROBOT's limits, not a
             tuning preference; commanding beyond them produces a command the
             robot cannot execute and an estimate-vs-achieved gap that looks
             like a fault and is not one.
           +/-1.0 m/s^2 and +/-2.5 rad/s^2 - CHOSEN plant assumptions, not
             datasheet figures: the Create 3 specification publishes no
             acceleration limit. They are here so the robot ramps instead of
             stepping instantaneously to a commanded velocity, and the teleop
             check's +/-0.15 rad/s tolerance on the measured peak yaw rate
             exists because of this ramp. Replace them with measured values if
             real-platform data ever becomes available.
         DiffDrive has NO command timeout: the last /cmd_vel is applied until a
         new one arrives. A Phase 4 communication fault therefore produces a
         robot that keeps driving on its last command, not one that stops - a
         modelled behavior with no watchdog behind it. Introducing one means
         adding a safety supervisor and describing it as such.
         DiffDrive also integrates wheel-joint rotation into /tf and /odom: that
         is genuine dead reckoning, it drifts, and it is the robot's own estimate
         - never simulator truth. -->
    <plugin filename="gz-sim-diff-drive-system" name="gz::sim::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.235</wheel_separation>
      <wheel_radius>0.036</wheel_radius>
      <topic>/model/ral_roomba/cmd_vel</topic>
      <odom_topic>/model/ral_roomba/odometry</odom_topic>
      <tf_topic>/model/ral_roomba/tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>50</odom_publish_frequency>
      <max_linear_acceleration>1.0</max_linear_acceleration>
      <min_linear_acceleration>-1.0</min_linear_acceleration>
      <max_angular_acceleration>2.5</max_angular_acceleration>
      <min_angular_acceleration>-2.5</min_angular_acceleration>
      <max_linear_velocity>0.46</max_linear_velocity>
      <max_angular_velocity>1.9</max_angular_velocity>
    </plugin>

    <!-- Publishes on /world/<world>/model/ral_roomba/joint_state as gz.msgs.Model. -->
    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher"/>

    <!-- Simulator TRUTH. Bridged to /ground_truth/tf and consumed only by
         ral_eval's ground_truth_node for evaluation and display. It must never
         be bridged into /tf - see config/bridge_roomba_ral_apartment.yaml. -->
    <plugin filename="gz-sim-pose-publisher-system" name="gz::sim::systems::PosePublisher">
      <publish_link_pose>false</publish_link_pose>
      <publish_model_pose>true</publish_model_pose>
      <use_pose_vector_msg>true</use_pose_vector_msg>
      <static_publisher>false</static_publisher>
      <update_frequency>50</update_frequency>
    </plugin>

  </model>
</sdf>
