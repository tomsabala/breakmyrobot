<?xml version="1.0" ?>
<!--
  Phase 0 rendering / performance gate.

  Minimal scene whose only job is to answer two questions on this machine:
    1. Does `gz sim --headless-rendering` produce a working ogre2 context, i.e.
       does the gpu_lidar publish at all?
    2. What real-time factor does a 360-sample lidar cost, so the lidar and
       physics parameters for every later world and robot can be chosen from a
       measurement instead of a guess?

  Geometry is deliberately exact so the published scan can be checked against
  arithmetic rather than eyeballed. The sensor sits at the origin at z = 0.5:
    beam  0 deg (+x) -> 1.5 m  (front face of the 1 m box centred at x = 2)
    beam +90 deg (+y) -> 4.0 m (side wall)
    beam 180 deg (-x) -> 5.0 m (end wall)
  Ranges are constant in time: the scene is static by design, so the measured
  RTF reflects sensor and physics cost only. Variation across beams, matching
  the distances above, is what proves the render pipeline is alive.
-->
<sdf version="1.9">
  <world name="gate_test">

    <physics name="default_physics" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material><ambient>0.8 0.8 0.8 1</ambient><diffuse>0.8 0.8 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- 10 m x 8 m enclosure: walls centred on x = +/-5 and y = +/-4. -->
    <model name="wall_x_pos">
      <static>true</static>
      <pose>5 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 8 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 8 2</size></box></geometry>
          <material><ambient>0.4 0.4 0.5 1</ambient><diffuse>0.4 0.4 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_x_neg">
      <static>true</static>
      <pose>-5 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.1 8 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.1 8 2</size></box></geometry>
          <material><ambient>0.4 0.4 0.5 1</ambient><diffuse>0.4 0.4 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_y_pos">
      <static>true</static>
      <pose>0 4 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.1 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.1 2</size></box></geometry>
          <material><ambient>0.4 0.4 0.5 1</ambient><diffuse>0.4 0.4 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_y_neg">
      <static>true</static>
      <pose>0 -4 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10 0.1 2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.1 2</size></box></geometry>
          <material><ambient>0.4 0.4 0.5 1</ambient><diffuse>0.4 0.4 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Obstacle: front face at x = 1.5, directly ahead of beam 0. -->
    <model name="obstacle_box">
      <static>true</static>
      <pose>2 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1 1 1</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material><ambient>0.7 0.3 0.2 1</ambient><diffuse>0.7 0.3 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Static pole carrying the lidar under test. -->
    <model name="lidar_pole">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <pose>0 0 0.25 0 0 0</pose>
        <collision name="collision">
          <geometry><cylinder><radius>0.05</radius><length>0.5</length></cylinder></geometry>
        </collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.05</radius><length>0.5</length></cylinder></geometry>
          <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
        </visual>

        <sensor name="gate_lidar" type="gpu_lidar">
          <pose>0 0 0.25 0 0 0</pose>
          <topic>scan_raw</topic>
          <update_rate>10</update_rate>
          <always_on>1</always_on>
          <visualize>false</visualize>
          <lidar>
            <scan>
              <horizontal>
                <samples>360</samples>
                <resolution>1</resolution>
                <min_angle>-3.14159</min_angle>
                <max_angle>3.14159</max_angle>
              </horizontal>
            </scan>
            <range>
              <min>0.15</min>
              <max>12.0</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
        </sensor>
      </link>
    </model>

  </world>
</sdf>
