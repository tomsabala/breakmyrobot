/RESILIENT_AUTONOMY_LAB_MVP_PLAN.md

# Run artifacts (bags, metrics, plots)
/runs/

# Stack launch logs the dashboard gateway captures, one per start
/logs/

# The dashboard's own build tooling. `dashboard/src` and its config ARE
# tracked; node_modules and the bundle are derived from them.
dashboard/node_modules/
dashboard/dist/
dashboard/.vite/

# The public static site. `site/build.mjs`, `site/template.mjs`,
# `site/assets/` and `site/content/` ARE tracked; the bundle under site/dist/
# is rendered from the repository's own markdown by scripts/build_site.sh and
# is reproducible from a fresh clone, so it is not committed.
site/node_modules/
site/dist/

# colcon
ros2_ws/build/
ros2_ws/install/
ros2_ws/log/
__pycache__/

# scripts/dev.sh sets HOME=/ws, so container tooling drops caches in the repo
/.gz/
/.ignition/
/.sdformat/
/.ros/
/.cache/
/.config/
/.local/
# The proof harness under /scripts/checks/ is TRACKED: docs/ cites it as the
# producer of the measured evidence, and evidence that cannot be regenerated by
# a fresh clone is not evidence. Only the launch log it captures is an artifact.
/scripts/checks/*.log
