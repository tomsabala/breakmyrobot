# Every repository built from source into the image's /opt/gz_ws overlay.
#
# Generic by design: Phase 0 needs only the Gazebo<->ROS 2 bridge, Phase 5 adds
# the ArduPilot stack, so this file is named for its role (the source overlay)
# rather than for any one of its entries.
#
# ros_gz must be built from source: the apt package ros-humble-ros-gz is
# compiled against Gazebo Fortress, and this project needs Harmonic because
# ardupilot_gazebo (Phase 5, the car) supports Garden/Harmonic/Ionic/Jetty only.
# sdformat_urdf converts the SDF robot models into URDF for robot_state_publisher.
#
# Upstream repository names are kept verbatim — they are fetch URLs and colcon
# package names, not labels.
repositories:
  ros_gz:
    type: git
    url: https://github.com/gazebosim/ros_gz.git
    version: humble
  sdformat_urdf:
    type: git
    url: https://github.com/ros/sdformat_urdf.git
    version: humble
  # The `ros2` branch, not `main`: it is the branch carrying the ament
  # environment hooks (SDF_PATH, GZ_SIM_SYSTEM_PLUGIN_PATH,
  # GZ_SIM_RESOURCE_PATH, upstream commit "Add SDF_PATH to the environment
  # hooks"), so sourcing /opt/gz_ws/install/setup.bash is what makes
  # ArduPilotPlugin loadable by name from a model's <plugin filename=...>.
  # `main` carries the same plugin code without those hooks.
  #
  # ArduPilot/SITL_Models is deliberately NOT imported: no SITL_Models entry is
  # an Ackermann car, which is why this project authors ral_car itself, and the
  # repository is ~100 MB of models nothing here loads.
  ardupilot_gazebo:
    type: git
    url: https://github.com/ArduPilot/ardupilot_gazebo.git
    version: ros2
